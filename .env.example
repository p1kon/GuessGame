# Copy to .env locally. Never commit .env or paste your token into a chat.
TELEGRAM_BOT_TOKEN=
# For the first run allow only your own numeric Telegram user ID.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_DB_PATH=private/telegram.sqlite
TELEGRAM_CONSENT_VERSION=owner-test-1
# Fill before startup: purpose, stored data, retention and owner contact.
# Example for a personal test only (replace the owner contact):
# TELEGRAM_CONSENT_TEXT="Личный тест GuessGame владельцем. Сохраняются Telegram ID отдельно от истории, выбранные биты, прогнозы, время и режим игры на компьютере владельца до удаления командой /delete. Экспорт: /export. Контакт владельца: укажите здесь. Копии в Telegram и ранее скачанные файлы удаляются отдельно."
TELEGRAM_CONSENT_TEXT=

# Optional authenticated web application, served behind HTTPS on the VPS.
PUBLIC_WEB_ORIGIN=https://67.21.76.143
WEB_REGISTRATION_CODE=
WEB_CONSENT_TEXT=
WEB_BOT_USERNAME=
