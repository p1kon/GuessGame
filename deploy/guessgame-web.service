[Unit]
Description=GuessGame authenticated web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guessgame
Group=guessgame
WorkingDirectory=/opt/guessgame/current
Environment=NODE_ENV=production
Environment=TELEGRAM_DB_PATH=/var/lib/guessgame/telegram.sqlite
Environment=WEB_PORT=3000
ExecStart=/opt/guessgame/node/bin/node --env-file=/etc/guessgame/guessgame.env scripts/web-server.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guessgame

[Install]
WantedBy=multi-user.target
