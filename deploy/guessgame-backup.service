[Unit]
Description=Consistent verified GuessGame database backup
After=guessgame.service

[Service]
Type=oneshot
User=guessgame
Group=guessgame
WorkingDirectory=/opt/guessgame/current
Environment=TELEGRAM_DB_PATH=/var/lib/guessgame/telegram.sqlite
Environment=BACKUP_DIRECTORY=/var/backups/guessgame
ExecStart=/opt/guessgame/node/bin/node scripts/backup-database.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/guessgame /var/lib/guessgame
